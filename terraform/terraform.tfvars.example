#   ANALYSIS_FOLDER_ID      = "YOUR_FOLDER_ID"
#   ANALYSIS_FOLDER_NAME    = "YOUR_FOLDER_NAME"
# }

invoker_members = [
  "user:you@example.com",
]

deployer_members = [
