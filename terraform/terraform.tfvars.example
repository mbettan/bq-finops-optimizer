project_id = "YOUR_PROJECT_ID"
org_id     = "YOUR_ORG_ID"
# folder_id = "YOUR_FOLDER_ID"
iam_scope  = "organization"
region     = "us-central1"

# Leave unset to create bq-finops-optimizer-runtime. Set to reuse an existing SA.
# runtime_service_account_email = "runtime@YOUR_PROJECT_ID.iam.gserviceaccount.com"

